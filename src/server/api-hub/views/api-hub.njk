{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-body" data-testid="app-page-body">

        <table class="govuk-table">
          <caption class="govuk-table__caption govuk-table__caption--m">Available APIs</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">API</th>
              <th scope="col" class="govuk-table__header">Team</th>
              <th scope="col" class="govuk-table__header">Format</th>
              <th scope="col" class="govuk-table__header"></th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">

          {% if errors|length %}
            <div class="govuk-error-summary" data-module="govuk-error-summary">
              <div role="alert">
                <h2 class="govuk-error-summary__title">
                  There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                  <ul class="govuk-list govuk-error-summary__list">
                    {% for error in errors %}
                    <li>
                      <a href="#">{{ error }}</a>
                    </li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            </div>
          {%  endif %}

          {% for api in apis %}
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">
              <a class="govuk-link" href="{{ api.serviceLink }}">{{ api.id }}</a>
            </th>
            <td class="govuk-table__header">
              <ul class="govuk-list">
                {% for team in api.teams %}<li>{{ team }}</li>{% endfor %}
              </ul>
            </td>
            <td class="govuk-table__cell">
              <strong class="govuk-tag app-tag govuk-tag--blue" data-testid="govuk-tag">
                {{ api.docType }}
              </strong>
            </td>
            <td class="govuk-table__cell">
                <a class="govuk-link" href="{{ api.link }}">View</a>
            </td>
          </tr>
          {%  endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

{% endblock %}
